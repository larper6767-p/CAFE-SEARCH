# Copy to .env and fill in real values. Never commit .env.

# Google Places API (see PROJECT.md section 8: billing cap required before bulk runs)
GOOGLE_PLACES_API_KEY=

# Supabase (Postgres + PostGIS)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, for ingestion jobs and migrations.
# Use the Supabase SESSION POOLER string (Dashboard → Connect → Session pooler):
#   postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# - Copy the exact pooler host + username from the Connect dialog; the pooler
#   host cannot be guessed from the region.
# - Why not the direct-connection host (db.<project-ref>.supabase.co): it is
#   IPv6-only unless the project buys the IPv4 add-on (Pro plan+), per supabase
#   docs "Endpoints and IP versions". The shared pooler is IPv4 on every plan.
# - Session mode (port 5432) keeps session state and prepared statements
#   working, unlike transaction mode (port 6543).
# - Append sslmode=require if the copied string does not already set it.
DATABASE_URL=

# SerpApi / Outscraper (optional, later — PROJECT.md section 8)
SERPAPI_KEY=
